<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linha" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="5dp" android:paddingBottom="5dp">
    <FrameLayout android:id="@+id/barra" android:layout_width="3dp" android:layout_height="match_parent" android:background="#7D9CF0" />
    <TextView android:id="@+id/hora" android:layout_width="52dp" android:layout_height="wrap_content"
        android:paddingLeft="8dp" android:textColor="#F4F6FB" android:textSize="14sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/titulo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#E8ECF2" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#9AA7C4" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
